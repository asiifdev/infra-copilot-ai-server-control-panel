{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.token)",
      "Read(.claude/hygiene-patterns.local)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools"
      }
    }
  },
  "enabledPlugins": {
    "svelte@svelte": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/tauri-guard.py\"",
            "timeout": 10,
            "statusMessage": "Tauri v2 guard"
          }
        ]
      }
    ]
  }
}
