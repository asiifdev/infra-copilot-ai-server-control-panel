#!/usr/bin/env bash
set -euo pipefail

# Quick pre-push gate: runs the fast checks (fmt, clippy, test, docs).
# Skips web build and gitleaks for speed — the full suite is ./scripts/check-ci.sh.

cd "$(git rev-parse --show-toplevel)"

# Ensure rustup default is set when both Homebrew and rustup coexist.
if [ -x "$HOME/.cargo/bin/rustup" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

echo "pre-push: fmt"
cargo fmt --all --check

echo "pre-push: clippy"
cargo clippy --workspace --all-targets --locked -- -D warnings

echo "pre-push: test"
cargo test --workspace --locked

echo "pre-push: docs"
python3 scripts/check-docs.py
python3 scripts/check-palette.py

echo "pre-push: all checks passed"
